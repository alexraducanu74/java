<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>org.example.jpa.entities.Continent</class>
        <class>org.example.jpa.entities.Country</class>
        <class>org.example.jpa.entities.City</class>

        <properties>
            <!-- JDBC config -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/cities"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>

            <!-- EclipseLink config -->
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.ddl-generation" value="none"/>

            <!-- Optional: For development -->
            <!-- <property name="eclipselink.ddl-generation" value="create-tables"/> -->
            <!-- <property name="eclipselink.ddl-generation.output-mode" value="database"/> -->

        </properties>
    </persistence-unit>
</persistence>
